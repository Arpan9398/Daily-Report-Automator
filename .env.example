# Copy this file to ".env" and fill in your values:  cp .env.example .env
# NEVER commit ".env" - it is listed in .gitignore.

# ---- SMTP / email (required only when sending email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (local test servers only)
SMTP_SECURITY=starttls
SMTP_USER=your.name@example.com
# For Gmail/Outlook use an app password, not your normal password
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your.name@example.com
# Comma-separated list of recipients
EMAIL_TO=manager@example.com,team@example.com

# ---- Report settings (all optional) ----
DATA_DIR=data/sample
OUTPUT_DIR=output
# {date} is replaced by YYYY-MM-DD
CSV_PATTERN=sales_{date}.csv
REPORT_TITLE=Daily Sales Report
# Days of history used for the trend chart
TREND_DAYS=7
